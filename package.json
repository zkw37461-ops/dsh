{
  "name": "@local/dsh-moss-precision",
  "version": "1.1.0",
  "private": true,
  "description": "MOSS-Image 三档精度组合的 DSH 插件，并在 MOSS 菜单中提供「moss提示词增强」：按 moss-image-prompt-skill 编译输入框提示词并整体替换。切换精度不下载、不替换权重。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "moss-image",
    "comfyui",
    "fp8",
    "precision",
    "prompt-enhance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkw37461-ops/dsh.git"
  },
  "homepage": "https://github.com/zkw37461-ops/dsh#readme",
  "bugs": {
    "url": "https://github.com/zkw37461-ops/dsh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server",
    "prompt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/prompt-enhance.test.js"
  },
  "license": "MIT"
}
